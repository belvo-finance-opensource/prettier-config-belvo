{
  "name": "@belvo/prettier-config-belvo",
  "version": "1.0.0",
  "description": "Belvo Prettier config for FE projects",
  "license": "MIT",
  "author": "Belvo Finance, S.L.",
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.js"
    }
  },
  "main": "index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check-dependencies": "npx npm-check-updates --target=latest --interactive",
    "format:check": "prettier --check './'",
    "format:fix": "prettier --write './'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "is-ci || husky",
    "verify": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@belvo/eslint-config-belvo": "1.0.6",
    "@stylistic/eslint-plugin": "5.8.0",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.7.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-cypress": "5.3.0",
    "eslint-plugin-no-only-tests": "3.3.0",
    "eslint-plugin-package-json": "0.88.3",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-vue": "10.8.0",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "lint-staged": "16.2.7",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2"
  },
  "lint-staged": {
    "*.{json,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,md,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0",
    "prettier-plugin-tailwindcss": ">=0.7"
  }
}
